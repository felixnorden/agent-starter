{
  "name": "@redwoodjs/starter",
  "version": "1.0.0",
  "private": true,
  "description": "A bare-bones RedwoodSDK starter",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "npm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && npm run clean && npm run build && wrangler deploy",
    "deploy": "pnpm run release",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "check:types": "tsc",
    "test": "vitest run",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@flue/sdk": "^2.3.0",
    "effect": "catalog:effect",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "rwsdk": "1.7.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "5.20261026.1",
    "@effect/tsgo": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "~8.3.5",
    "vitest": "catalog:effect",
    "wrangler": "4.152.0"
  }
}
