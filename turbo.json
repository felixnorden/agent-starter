{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"],
  "globalDependencies": ["oxlint.config.ts", "oxfmt.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check:types": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "fmt": {
      "cache": false
    },
    "fmt:check": {},
    "deploy": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
